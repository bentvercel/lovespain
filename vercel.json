{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server/ghl",
      "destination": "/api/ghl-mcp?mode=oauth_metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/ghl-mcp",
      "destination": "/api/ghl-mcp?mode=protected_metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp?mode=oauth_metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?mode=protected_metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/mcp?mode=protected_metadata"
    }
  ]
}
